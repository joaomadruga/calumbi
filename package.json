    "react": "19.2.4",
    "react-dom": "19.2.4",
    "lucide-react": "0.545.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "20.19.39",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  }
}
